#!/bin/bash
cd "$(dirname "$0")" || exit 1
echo "========================================"
echo "  开机自动启动 —— 关闭"
echo "========================================"
echo
./service.sh autostart-off
echo
echo "----------------------------------------"
echo "已取消开机自启，当前实例也已停止。"
echo "以后要用，双击「1-启动服务」手动启动。"
echo "----------------------------------------"
read -r -p "按 回车键 关闭本窗口..."
