#!/bin/bash
cd "$(dirname "$0")" || exit 1
echo "========================================"
echo "  开机自动启动 —— 开启"
echo "========================================"
echo
./service.sh autostart-on
echo
echo "----------------------------------------"
echo "以后每次开机/登录，服务会自动在后台启动。"
echo "想取消，双击「6-开机自启-关闭」。"
echo "----------------------------------------"
read -r -p "按 回车键 关闭本窗口..."
