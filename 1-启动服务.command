#!/bin/bash
cd "$(dirname "$0")" || exit 1
echo "========================================"
echo "  网址自动访问器 —— 启动"
echo "========================================"
echo
./service.sh start
echo
echo "----------------------------------------"
echo "服务已启动，浏览器会自动打开界面。"
echo "如果没弹出，手动在浏览器地址栏输入："
echo "    http://127.0.0.1:8765"
echo
echo "关掉这个黑框窗口，服务依然在后台运行。"
echo "----------------------------------------"
read -r -p "看完后按 回车键 关闭本窗口..."
