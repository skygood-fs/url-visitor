#!/bin/bash
cd "$(dirname "$0")" || exit 1
echo "========================================"
echo "  网址自动访问器 —— 停止"
echo "========================================"
echo
./service.sh stop
echo
echo "----------------------------------------"
echo "服务已停止，浏览器界面会打不开（正常现象）。"
echo "想再用，双击「1-启动服务」。"
echo "----------------------------------------"
read -r -p "按 回车键 关闭本窗口..."
